# AuthKit Tier 1S: Larger Solo VPS Current-Code
# Target: low-cost Wavern deployments that outgrow Tier 0S but still accept
# single-instance operation.
# Expected envelope: $28.80-$35.20/month before taxes, 501-1,500 registered users.
#
# Replace every CHANGE-ME value before running outside dev/test. ProductionConfigValidator
# intentionally rejects CHANGE-ME placeholders and insecure defaults.

SPRING_PROFILES_ACTIVE=prod
JAVA_TOOL_OPTIONS='-Xms512m -Xmx1536m -Dfile.encoding=UTF-8'
SERVER_PORT=8080

DB_URL=jdbc:postgresql://127.0.0.1:5432/authkit
DB_USERNAME=authkit
DB_PASSWORD=CHANGE-ME-DB-PASSWORD
DB_POOL_MAX_SIZE=8
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECT_TIMEOUT_MS=3000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE-ME-REDIS-PASSWORD
AUTH_TOKEN_STORAGE_BACKEND=redis
AUTH_TOKEN_STORAGE_SINGLE_INSTANCE_MODE=false

JWT_PRIVATE_KEY=file:/etc/authkit/keys/authkit-rs256.key
JWT_PUBLIC_KEY=file:/etc/authkit/keys/authkit-rs256.pub
AUTH_JWT_ISSUER=CHANGE-ME-HTTPS-AUTHKIT-ISSUER
AUTH_JWT_AUDIENCE=wavern-authkit-api
AUTH_JWT_KEY_ID=wavern-authkit-2026-06-05
AUTH_JWT_RETIRING_PUBLIC_KEYS=
AUTH_JWT_REVOKED_KEY_IDS=

AUTH_FRONTEND_ACTIVATION_URL=CHANGE-ME-HTTPS-ACTIVATION-URL
AUTH_FRONTEND_PASSWORD_RESET_URL=CHANGE-ME-HTTPS-PASSWORD-RESET-URL
AUTH_CORS_ENABLED=true
AUTH_CORS_ALLOWED_ORIGINS=http://CHANGE-ME-WAVERN-ORIGIN,http://CHANGE-ME-AUTHKIT-ORIGIN
AUTH_CORS_ALLOWED_METHODS=GET,POST,PATCH,DELETE,OPTIONS
AUTH_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-XSRF-TOKEN,X-Worker-Token
AUTH_CORS_EXPOSED_HEADERS=Location
AUTH_CORS_ALLOW_CREDENTIALS=true
AUTH_CORS_MAX_AGE_SECONDS=3600
AUTH_CSRF_ENABLED=true
AUTH_CSRF_COOKIE_NAME=XSRF-TOKEN
AUTH_CSRF_HEADER_NAME=X-XSRF-TOKEN
AUTH_CSRF_COOKIE_PATH=/api/v1/auth
AUTH_CSRF_TOKEN_BYTES=32

AUTH_REFRESH_COOKIE_NAME=Refresh-Token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_COOKIE_HTTP_ONLY=true
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=Strict

AUTH_EMAIL_OUTBOX_ENABLED=true
AUTH_EMAIL_OUTBOX_DISPATCH_MODE=direct
AUTH_EMAIL_OUTBOX_BATCH_SIZE=50
AUTH_EMAIL_OUTBOX_DIRECT_BATCH_SIZE=10
AUTH_EMAIL_OUTBOX_POLL_DELAY_MS=5000
AUTH_EMAIL_OUTBOX_LOCK_TTL_SECONDS=300
AUTH_EMAIL_OUTBOX_DELIVERY_ACK_TIMEOUT_SECONDS=600
AUTH_EMAIL_OUTBOX_SCHEDULER_POOL_SIZE=1
AUTH_EMAIL_OUTBOX_DIRECT_CORE_POOL_SIZE=2
AUTH_EMAIL_OUTBOX_DIRECT_MAX_POOL_SIZE=3
AUTH_EMAIL_OUTBOX_DIRECT_QUEUE_CAPACITY=50
AUTH_EMAIL_OUTBOX_PRESERVE_RABBIT_OBSERVABILITY=false
AUTH_EMAIL_OUTBOX_MAX_ATTEMPTS=10

AUTH_EMAIL_PROVIDER_TYPE=resend
AUTH_EMAIL_PROVIDER_FROM='CHANGE-ME-AUTHKIT-FROM <auth@change-me.invalid>'
AUTH_EMAIL_PROVIDER_CONNECT_TIMEOUT_MS=2000
AUTH_EMAIL_PROVIDER_READ_TIMEOUT_MS=5000
AUTH_EMAIL_PROVIDER_MAX_ATTEMPTS=3
AUTH_EMAIL_PROVIDER_RETRY_BACKOFF_MS=250
RESEND_API_KEY=CHANGE-ME-RESEND-API-KEY
# SMTP alternative when AUTH_EMAIL_PROVIDER_TYPE=smtp:
# AUTH_EMAIL_SMTP_HOST=smtp.example.com
# AUTH_EMAIL_SMTP_PORT=587
# AUTH_EMAIL_SMTP_AUTH=true
# AUTH_EMAIL_SMTP_USERNAME=authkit@example.com
# AUTH_EMAIL_SMTP_PASSWORD=CHANGE-ME-SMTP-PASSWORD
# AUTH_EMAIL_SMTP_STARTTLS_ENABLED=true
# AUTH_EMAIL_SMTP_STARTTLS_REQUIRED=true
# AUTH_EMAIL_SMTP_SSL_ENABLED=false

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=7
AUTH_RECOVERY_TOKEN_TTL_MINUTES=15
AUTH_REGISTRATION_STEALTH_CONFLICTS=true
AUTH_EMAIL_CONFIRMATION_TTL_HOURS=24
AUTH_AUTHORITY_CACHE_TTL_SECONDS=30
AUTH_AUTHORITY_CACHE_MAX_SIZE=10000
AUTH_MAX_REQUEST_BODY_BYTES=65536

AUTH_ABUSE_CONTROL_CAPACITY_MULTIPLIER=1
AUTH_ABUSE_FAIL_CLOSED_HIGH_RISK=false
AUTH_PASSWORD_HIBP_ENABLED=false
AUTH_PASSWORD_HIBP_CONNECT_TIMEOUT_MS=1000
AUTH_PASSWORD_HIBP_READ_TIMEOUT_MS=2000
AUTH_PASSWORD_HIBP_CACHE_TTL_SECONDS=86400
AUTH_PASSWORD_HIBP_CACHE_MAX_PREFIXES=10000

SECURITY_ARGON2_MEMORY=32768
SECURITY_ARGON2_ITERATIONS=2
SECURITY_ARGON2_PARALLELISM=1
SECURITY_ARGON2_MAX_CONCURRENT=0

AUTH_SCHEDULER_DISTRIBUTED_LOCK_ENABLED=true
AUTH_EMAIL_POLL_LOCK_AT_MOST=PT10M
AUTH_RETENTION_LOCK_AT_MOST=PT2H
AUTH_RETENTION_LOCK_AT_LEAST=PT1M

AUTH_TERMS_VERSION=wavern-terms-2026-06-05
AUTH_PRIVACY_POLICY_VERSION=wavern-privacy-2026-06-05
AUTH_LAWFUL_BASIS=consent
AUTH_SECURITY_EVENT_RETENTION_DAYS=365
AUTH_DELETED_ACCOUNT_RETENTION_DAYS=30
AUTH_DATA_EXPORT_SECURITY_EVENT_LIMIT=100
AUTH_RETENTION_BATCH_SIZE=500
AUTH_RETENTION_JOB_ENABLED=true
AUTH_RETENTION_JOB_CRON='0 30 3 * * *'
AUTH_AUDIT_HASH_PEPPER=CHANGE-ME-AUDIT-HASH-PEPPER-AT-LEAST-32-CHARS
AUTH_AUDIT_ASYNC_ENABLED=true
AUTH_AUDIT_WRITER_CORE_POOL_SIZE=2
AUTH_AUDIT_WRITER_MAX_POOL_SIZE=3
AUTH_AUDIT_WRITER_QUEUE_CAPACITY=2500
AUTH_AUDIT_WRITER_SHUTDOWN_TIMEOUT_SECONDS=10
AUTH_AUDIT_SYNC_ON_OVERLOAD=true

AUTH_MFA_ENABLED=true
AUTH_MFA_BACKUP_CODE_COUNT=10
AUTH_MFA_LOGIN_CHALLENGE_TTL_MINUTES=5
AUTH_MFA_SECRET_ENCRYPTION_KEY=CHANGE-ME-MFA-SECRET-ENCRYPTION-KEY-AT-LEAST-32-CHARS
AUTH_MFA_SECRET_ENCRYPTION_KEY_ID=wavern-mfa-2026-06-05
AUTH_MFA_PREVIOUS_SECRET_ENCRYPTION_KEYS=
AUTH_MFA_SECRET_ENCRYPTION_KDF_ITERATIONS=210000
AUTH_MFA_STATUS_CACHE_TTL_SECONDS=60
AUTH_MFA_STATUS_CACHE_MAX_SIZE=10000
AUTH_PASSKEY_ENABLED=true
AUTH_PASSKEY_RP_ID=CHANGE-ME-PASSKEY-RP-ID
AUTH_PASSKEY_RP_NAME=Wavern
AUTH_PASSKEY_ORIGINS=CHANGE-ME-HTTPS-WAVERN-ORIGIN,CHANGE-ME-HTTPS-AUTHKIT-ORIGIN
AUTH_PASSKEY_CHALLENGE_TTL_MINUTES=5
AUTH_PASSKEY_ALLOW_ORIGIN_PORT=false
AUTH_PASSKEY_ALLOW_ORIGIN_SUBDOMAIN=false

AUTH_OAUTH_PROVIDER_ENABLED=true
AUTH_OAUTH_AUTHORIZATION_CODE_TTL_MINUTES=5
AUTH_OAUTH_ID_TOKEN_TTL_SECONDS=900

WORKER_TOKEN=CHANGE-ME-SECURE-WORKER-TOKEN
WORKER_PREVIOUS_TOKENS=
NETWORK_SECURITY_TRUSTED_ORIGINS=127.0.0.1/32
NETWORK_PROXY_DEPTH=1
