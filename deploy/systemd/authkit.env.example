# Copy to /etc/authkit/authkit.env, set ownership root:authkit, chmod 0640.
# Replace every CHANGE-ME value. Do not commit the copied file.

DB_URL=jdbc:postgresql://127.0.0.1:5432/authkit
DB_USERNAME=authkit
DB_PASSWORD=CHANGE-ME-postgres-password
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE-ME-redis-password
AUTH_TOKEN_STORAGE_BACKEND=redis
AUTH_TOKEN_STORAGE_SINGLE_INSTANCE_MODE=false

JWT_PUBLIC_KEY=file:/etc/authkit/keys/public.pem
JWT_PRIVATE_KEY=file:/etc/authkit/keys/private.pem
AUTH_JWT_ISSUER=https://auth.example.com
AUTH_JWT_AUDIENCE=authkit-api
AUTH_JWT_KEY_ID=authkit-key-1

AUTH_FRONTEND_ACTIVATION_URL=https://app.example.com/activate
AUTH_FRONTEND_PASSWORD_RESET_URL=https://app.example.com/reset-password
AUTH_CORS_ALLOWED_ORIGINS=https://app.example.com
AUTH_CSRF_ENABLED=true
AUTH_REFRESH_COOKIE_SECURE=true

AUTH_EMAIL_OUTBOX_ENABLED=true
AUTH_EMAIL_OUTBOX_DISPATCH_MODE=direct
AUTH_EMAIL_PROVIDER_TYPE=smtp
AUTH_EMAIL_PROVIDER_FROM=AuthKit <security@example.com>
AUTH_EMAIL_SMTP_HOST=smtp.example.com
AUTH_EMAIL_SMTP_PORT=587
AUTH_EMAIL_SMTP_AUTH=true
AUTH_EMAIL_SMTP_USERNAME=CHANGE-ME-smtp-user
AUTH_EMAIL_SMTP_PASSWORD=CHANGE-ME-smtp-password
AUTH_EMAIL_SMTP_STARTTLS_ENABLED=true
AUTH_EMAIL_SMTP_STARTTLS_REQUIRED=true
AUTH_EMAIL_SMTP_SSL_ENABLED=false
RESEND_API_KEY=CHANGE-ME-if-using-resend

AUTH_TERMS_VERSION=2026-06
AUTH_PRIVACY_POLICY_VERSION=2026-06
AUTH_AUDIT_HASH_PEPPER=CHANGE-ME-32-byte-random-pepper
AUTH_MFA_SECRET_ENCRYPTION_KEY=CHANGE-ME-32-byte-minimum-random-key
AUTH_MFA_SECRET_ENCRYPTION_KEY_ID=mfa-key-1
AUTH_PASSKEY_RP_ID=auth.example.com
AUTH_PASSKEY_RP_NAME=AuthKit
AUTH_PASSKEY_ORIGINS=https://auth.example.com,https://app.example.com

AUTH_SCHEDULER_DISTRIBUTED_LOCK_ENABLED=true
AUTH_ABUSE_FAIL_CLOSED_HIGH_RISK=false
AUTH_PASSWORD_HIBP_ENABLED=false
SECURITY_ARGON2_MAX_CONCURRENT=1
WORKER_TOKEN=CHANGE-ME-worker-token
