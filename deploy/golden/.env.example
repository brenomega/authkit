# Non-secret golden-path configuration. Copy to .env and keep the copy untracked.
AUTHKIT_IMAGE=authkit:local
AUTHKIT_PUBLIC_HOST=auth.example.com
AUTHKIT_HTTPS_PORT=443
AUTHKIT_JWT_AUDIENCE=https://api.example.com
AUTHKIT_JWT_KEY_ID=authkit-2026-01
AUTHKIT_FRONTEND_ACTIVATION_URL=https://app.example.com/activate
AUTHKIT_FRONTEND_PASSWORD_RESET_URL=https://app.example.com/reset-password
AUTHKIT_FRONTEND_EMAIL_CHANGE_URL=https://app.example.com/change-email
AUTHKIT_REGISTRATION_MODE=restricted
AUTHKIT_TERMS_VERSION=2026-01
AUTHKIT_PRIVACY_POLICY_VERSION=2026-01
AUTHKIT_LAWFUL_BASIS=consent
AUTHKIT_EMAIL_FROM=Auth Service <security@example.com>
AUTHKIT_EMAIL_PROVIDER_TYPE=smtp
AUTHKIT_SMTP_HOST=smtp.example.com
AUTHKIT_SMTP_PORT=587
AUTHKIT_SMTP_AUTH=true
AUTHKIT_SMTP_USERNAME=authkit-smtp-user
AUTHKIT_CORS_ALLOWED_ORIGINS=https://app.example.com
AUTHKIT_PASSKEY_RP_ID=auth.example.com
AUTHKIT_PASSKEY_RP_NAME=Example Auth
AUTHKIT_PASSKEY_ORIGINS=https://auth.example.com,https://app.example.com
AUTHKIT_OAUTH_AUTHORIZATION_UI_URL=https://app.example.com/oauth/authorize
AUTHKIT_SOCIAL_ENABLED=false
AUTHKIT_MFA_KEY_ID=mfa-2026-01
AUTHKIT_ARGON2_MAX_CONCURRENT=2
AUTHKIT_EMAIL_TEMPLATES_DIRECTORY=/absolute/operator/path/authkit-email-templates
AUTHKIT_SECRETS_DIRECTORY=./secrets
