# Copy to deploy/compose/.env.jdbc-direct and replace every CHANGE-ME value.
# This template is for PostgreSQL-only token storage. It is single-instance only.

AUTHKIT_HOST_PORT=8080

POSTGRES_DB=authkit
POSTGRES_USER=authkit
POSTGRES_PASSWORD=CHANGE-ME-postgres-password
DB_URL=jdbc:postgresql://postgres:5432/authkit
DB_USERNAME=authkit
DB_PASSWORD=CHANGE-ME-postgres-password
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=1

AUTH_TOKEN_STORAGE_BACKEND=jdbc
AUTH_TOKEN_STORAGE_SINGLE_INSTANCE_MODE=true
AUTH_TOKEN_STORAGE_JDBC_CLEANUP_DELAY_MS=300000

AUTH_EMAIL_OUTBOX_ENABLED=true
AUTH_EMAIL_OUTBOX_DISPATCH_MODE=direct
AUTH_EMAIL_OUTBOX_DIRECT_CORE_POOL_SIZE=1
AUTH_EMAIL_OUTBOX_DIRECT_MAX_POOL_SIZE=1
AUTH_EMAIL_OUTBOX_DIRECT_QUEUE_CAPACITY=25
AUTH_EMAIL_PROVIDER_TYPE=smtp
AUTH_EMAIL_PROVIDER_FROM=AuthKit Local <authkit@example.test>
AUTH_EMAIL_SMTP_HOST=mailpit
AUTH_EMAIL_SMTP_PORT=1025
AUTH_EMAIL_SMTP_AUTH=false
AUTH_EMAIL_SMTP_USERNAME=
AUTH_EMAIL_SMTP_PASSWORD=
AUTH_EMAIL_SMTP_STARTTLS_ENABLED=false
AUTH_EMAIL_SMTP_STARTTLS_REQUIRED=false
AUTH_EMAIL_SMTP_SSL_ENABLED=false
RESEND_API_KEY=CHANGE-ME-if-using-resend

JWT_PUBLIC_KEY=file:/run/secrets/authkit/public.pem
JWT_PRIVATE_KEY=file:/run/secrets/authkit/private.pem
AUTH_JWT_ISSUER=http://localhost:8080
AUTH_JWT_AUDIENCE=authkit-api
AUTH_JWT_KEY_ID=authkit-key-1

AUTH_FRONTEND_ACTIVATION_URL=http://localhost:3000/activate
AUTH_FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password
AUTH_CORS_ENABLED=true
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_CSRF_ENABLED=true
AUTH_REFRESH_COOKIE_SECURE=true

AUTH_TERMS_VERSION=2026-06
AUTH_PRIVACY_POLICY_VERSION=2026-06
AUTH_AUDIT_HASH_PEPPER=CHANGE-ME-32-byte-random-pepper
AUTH_MFA_SECRET_ENCRYPTION_KEY=CHANGE-ME-32-byte-minimum-random-key
AUTH_MFA_SECRET_ENCRYPTION_KEY_ID=mfa-key-1
AUTH_PASSKEY_RP_ID=localhost
AUTH_PASSKEY_RP_NAME=AuthKit
AUTH_PASSKEY_ORIGINS=http://localhost:3000

AUTH_SCHEDULER_DISTRIBUTED_LOCK_ENABLED=true
AUTH_ABUSE_FAIL_CLOSED_HIGH_RISK=false
AUTH_PASSWORD_HIBP_ENABLED=false
SECURITY_ARGON2_MAX_CONCURRENT=1
WORKER_TOKEN=CHANGE-ME-worker-token
