# ==============================================================================
# AuthKit .gitignore — Reinforced for security (DT 3.2.2, DT 3.1.26)
# ==============================================================================

### Build artifacts ###
target/
!**/src/main/**/target/
!**/src/test/**/target/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### RSA Keys — NEVER commit production keys (DT 3.2.2) ###
*.key
*.pub
*.pem
# Exception: test-only keys used by @ActiveProfiles("test") are safe to commit
!src/main/resources/test-keys/*.key
!src/main/resources/test-keys/*.pub

### Environment and secrets ###
.env
*.env.*
!*.env.example
!**/*.env.example
!deploy/compose/.env.*.example
application-local.yml
application-local.properties
*secrets.yaml

### IDE — IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr

### IDE — VS Code ###
.vscode/

### IDE — Eclipse / STS ###
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

### IDE — NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

### OS ###
.DS_Store
Thumbs.db

### Logs ###
*.log
logs/
docs/proof/reports/
